  "description": "Your feed, in the order it was published.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f6eee2",
  "theme_color": "#f6eee2",
  "categories": ["news", "entertainment", "productivity"],
