# Copy to .env — docker compose reads it automatically.

# Where people reach Pamphlets. A plugin's sign-in redirect URI is this plus
# /oauth/callback, and it must match the OAuth client exactly. Behind a
# reverse proxy this is the public https URL, not the container address.
PAMPHLETS_PUBLIC_URL=http://localhost:8080

# -- Plugin settings -------------------------------------------------------
# Any plugin's settings for everyone can be given here instead of on its card
# under Admin -> Plugins, as PAMPHLETS_PLUGIN_<PLUGIN>_<SETTING>. The YouTube
# plugin's: an OAuth client (type "Web application") from the Google Cloud
# console with the YouTube Data API v3 enabled, and an optional API key that
# lets @handles be resolved before anyone has signed in.
PAMPHLETS_PLUGIN_YOUTUBE_CLIENT_ID=
PAMPHLETS_PLUGIN_YOUTUBE_CLIENT_SECRET=
PAMPHLETS_PLUGIN_YOUTUBE_API_KEY=

# -- Accounts --------------------------------------------------------------
# Setting both of these turns sign-in on and creates the admin account. The
# password is read on every start, so changing it here and restarting is the
# way back in if it is ever lost — which is why the admin's password cannot be
# changed from inside the app. Leave them empty and Pamphlets asks nobody who
# they are, exactly as it did before accounts existed.
PAMPHLETS_ADMIN_USER=
PAMPHLETS_ADMIN_PASSWORD=

# Trying it out on your own machine? admin / admin works. Pamphlets allows a
# short password here because it comes from the environment rather than from a
# form, and warns in the log and on the page for as long as it stands. It is
# not a default: these two lines are commented out on purpose.
# PAMPHLETS_ADMIN_USER=admin
# PAMPHLETS_ADMIN_PASSWORD=admin

# How long a signed-in browser stays signed in.
# PAMPHLETS_SESSION_DAYS=30

# --- deployment ------------------------------------------------------------

# Where the published port is bound. Use 127.0.0.1:8080 to keep it off the
# network when a reverse proxy on the same host will front it.
# PAMPHLETS_BIND=0.0.0.0:8080

# Deploy a registry image instead of building locally.
# PAMPHLETS_IMAGE=registry.example.com/pamphlets:0.1.0

# A named volume (default) or an absolute host path. Keep it on local disk:
# SQLite over NFS/CIFS will corrupt.
# PAMPHLETS_DATA=pamphlets-data

# Used by compose.cluster.yml.
# PAMPHLETS_HOSTNAME=pamphlets.example.com
# PAMPHLETS_PROXY_NETWORK=proxy
# TRAEFIK_ENTRYPOINT=websecure
# TRAEFIK_CERT_RESOLVER=letsencrypt

# TZ=Europe/London
# PAMPHLETS_MEMORY_LIMIT=512M
# PAMPHLETS_LOG_LEVEL=INFO
