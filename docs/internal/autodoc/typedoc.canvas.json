{
  "$schema": "https://typedoc.org/schema.json",
  "name": "De-Algo canvas",
  "tsconfig": "../../../tsconfig.graph.json",
  "entryPoints": ["../../../dealgo/web/ts/graph/*.ts"],
  "out": "canvas",
  "readme": "none",
  "excludeExternals": true,
  "disableSources": true,
